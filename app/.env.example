# Copy to app/.env (gitignored) and adjust. Every variable is optional.
# Relative paths are resolved against the app/ directory.

# HTTP port (1-65535).
PORT=3000

# Repository root; must be an existing directory. Default: ".." (parent of app/).
# REPO_ROOT=..

# Project YAML snapshot source. Default: <REPO_ROOT>/config/project.yaml.
# PROJECT_CONFIG_PATH=../config/project.yaml

# Where run artifacts (NetCDF, manifests) are written. Default: <REPO_ROOT>/artifacts
# ARTIFACT_DIR=../artifacts

# Python interpreter used to spawn the solver.
# Default: <REPO_ROOT>/.venv/Scripts/python.exe on Windows, <REPO_ROOT>/.venv/bin/python otherwise.
# A bare command name (e.g. python3) is looked up on PATH.
# PYTHON_BIN=../.venv/Scripts/python.exe

# PostgreSQL/PostGIS. This value matches `docker compose up -d db` (repo root):
# DEV-ONLY credentials ie402/ie402 on host port 5433. Never commit real credentials.
# Unset = DB-backed routes answer 503 and the executor stays idle.
DATABASE_URL=postgres://ie402:ie402@localhost:5433/ie402

# Integration tests use a separate database, default <DATABASE_URL name>_test
# (created on demand). Override if needed.
# TEST_DATABASE_URL=postgres://ie402:ie402@localhost:5433/ie402_test

# Solver mode: "mock" adds --mock (synthetic field, contract-exact artifacts),
# "real" runs the real solver (spec D2). Default: mock.
SOLVER_MODE=mock

# Mock mode only: make every run fail on purpose with exit 2/3/4 (input|model|system).
# SOLVER_MOCK_FAIL=model

# Wall-clock limit of one solver process, seconds. Exceeding it kills the
# process and fails the run with error.kind = timeout. Default: 900.
SOLVER_TIMEOUT_S=900

# Command prefix as a JSON array. Default: [PYTHON_BIN, "-m", "src.solver"].
# Tests point it at test/fixtures/fake-solver.mjs. Run from REPO_ROOT, no shell.
# SOLVER_CMD=["node", "app/test/fixtures/fake-solver.mjs"]

# Internal executor (concurrency 1). false = API only, runs stay queued.
EXECUTOR_ENABLED=true

# How often the executor polls the database for queued runs, milliseconds (>= 10).
EXECUTOR_POLL_MS=1000
